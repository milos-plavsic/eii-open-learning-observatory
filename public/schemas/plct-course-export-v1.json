{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eii.edu.eu/schemas/plct-course-export-v1.json",
  "title": "Proposed PLCT course export contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "course_key",
    "language",
    "version",
    "activities"
  ],
  "properties": {
    "format": {
      "const": "plct-course-export-v1"
    },
    "course_key": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "string",
        "integer"
      ],
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "query_context_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "activity_key",
          "retrieved"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "activity_key": {
            "type": [
              "string",
              "integer"
            ]
          },
          "retrieved": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "block_id",
                "block_hash",
                "score"
              ],
              "properties": {
                "block_id": {
                  "type": "string",
                  "minLength": 1
                },
                "block_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "petlja_attestation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "maintainer",
        "reviewed_at"
      ],
      "properties": {
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository_revision": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "canonical_course_id": {
      "type": "string"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "activity_key"
        ],
        "additionalProperties": true,
        "properties": {
          "activity_key": {
            "type": [
              "string",
              "integer"
            ],
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "translation_id": {
            "type": [
              "string",
              "integer"
            ]
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "learning_objectives": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "kind": {
            "enum": [
              "course",
              "activity",
              "section",
              "exercise",
              "assessment"
            ]
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chunk_key"
              ],
              "additionalProperties": true,
              "properties": {
                "chunk_key": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "section",
                    "exercise",
                    "assessment"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "translation_id": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "concepts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "learning_objectives": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "metadata": {
                  "type": "object"
                }
              }
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  }
}

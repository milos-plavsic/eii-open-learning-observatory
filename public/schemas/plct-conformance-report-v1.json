{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eii.edu.eu/schemas/plct-conformance-report-v1.json",
  "title": "EII PLCT boundary conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_hash",
    "course_release_id",
    "course_release_hash",
    "checks",
    "compatible",
    "external_attestation",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "export_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "course_release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "course_release_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compatible": {
      "type": "boolean"
    },
    "external_attestation": {
      "type": [
        "object",
        "null"
      ]
    },
    "report_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eii.edu.eu/schemas/external-validation-record-v1.json",
  "title": "EII external validation record",
  "type": "object", "additionalProperties": false,
  "required": ["id", "statement", "key_fingerprint", "signature"],
  "properties": {
    "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "key_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9+/]+={0,2}$"},
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "gate_type", "executed_at", "organization", "reviewer", "scope", "procedure_version", "subject_hashes", "outcome", "findings", "limitations"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "gate_type": {"enum": ["petlja-integration", "human-accuracy", "penetration-test", "independent-reproduction", "target-school-pilot"]},
        "executed_at": {"type": "string", "format": "date-time"}, "organization": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1},
        "procedure_version": {"type": "string", "minLength": 1},
        "subject_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "outcome": {"enum": ["passed", "failed", "conditional"]},
        "findings": {"type": "array", "items": {"type": "object"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

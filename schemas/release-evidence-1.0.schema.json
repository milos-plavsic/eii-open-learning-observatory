{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eii.edu.eu/schemas/release-evidence-1.0.json",
  "title": "EII release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "version", "revision", "source_digest", "created_at", "artifacts", "spdx"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "size", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
          "kind": {"enum": ["python-wheel", "python-sdist"]},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "spdx": {"type": "object"}
  }
}

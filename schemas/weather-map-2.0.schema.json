{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eii.edu.eu/schemas/weather-map-2.0.json",
  "title": "EII privacy-preserving classroom weather export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "privacy", "cells"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_group_size", "retention_days", "max_events_per_contributor_per_cell_per_day", "timestamp_precision", "raw_conversations_stored", "direct_identifiers_stored", "count_granularity", "minimum_export_interval_hours", "key_epoch", "contribution_linkage"],
      "properties": {
        "minimum_group_size": {"type": "integer", "minimum": 2}, "retention_days": {"type": "integer", "minimum": 1},
        "max_events_per_contributor_per_cell_per_day": {"type": "integer", "minimum": 1}, "timestamp_precision": {"const": "utc-day"},
        "raw_conversations_stored": {"const": false}, "direct_identifiers_stored": {"const": false},
        "count_granularity": {"type": "integer", "minimum": 1}, "minimum_export_interval_hours": {"type": "integer", "minimum": 1},
        "key_epoch": {"type": "string", "minLength": 1, "maxLength": 64}, "contribution_linkage": {"const": "within-cell-day-only-pseudonymous"}
      }
    },
    "cells": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["course_key", "activity_key", "language", "concept_id", "signal", "event_count", "contributor_count", "explanation", "recommendation"],
      "properties": {
        "course_key": {"type": "string", "minLength": 1}, "activity_key": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1}, "concept_id": {"type": "string", "minLength": 1},
        "signal": {"enum": ["misconception", "repeated_question", "complete_answer_request", "frustration", "abandonment", "retrieval_failure", "unsupported_question"]},
        "event_count": {"type": "integer", "minimum": 1}, "contributor_count": {"type": "integer", "minimum": 2},
        "explanation": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}
      }
    }}
  }
}

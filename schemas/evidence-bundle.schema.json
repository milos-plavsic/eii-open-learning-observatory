{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://eii.edu.eu/schemas/evidence-bundle-2.0.json","title":"EII Evidence Bundle",
  "type":"object","additionalProperties":false,
  "required":["id","schema_version","created_at","tool_version","course_releases","findings","reviews","model_runs","metadata"],
  "properties":{"id":{"$ref":"#/$defs/hash"},"schema_version":{"const":"2.0"},"created_at":{"type":"string","format":"date-time"},"tool_version":{"type":"string","minLength":1},"course_releases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/release"}},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},"reviews":{"type":"array","items":{"$ref":"#/$defs/review"}},"model_runs":{"type":"array","items":{"$ref":"#/$defs/modelRun"}},"metadata":{"$ref":"#/$defs/metadata"}},
  "$defs":{
    "hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"nullableString":{"type":["string","null"]},
    "semanticPlanItem":{"type":"object","additionalProperties":false,"required":["relationship_id","left_release_id","right_release_id"],"properties":{"relationship_id":{"type":"string","minLength":1},"left_release_id":{"type":"string","minLength":1},"right_release_id":{"type":"string","minLength":1}}},
    "metadata":{"type":"object","properties":{"semantic_evaluations_schema_version":{"const":"1.0"},"semantic_evaluations":{"type":"array","items":{"$ref":"https://eii.edu.eu/schemas/semantic-evaluation-record-1.0.json"}},"semantic_evaluation_plan":{"type":"array","items":{"$ref":"#/$defs/semanticPlanItem"},"uniqueItems":true}},"dependentRequired":{"semantic_evaluations":["semantic_evaluations_schema_version","semantic_evaluation_plan"],"semantic_evaluation_plan":["semantic_evaluations_schema_version","semantic_evaluations"]}},
    "locator":{"type":"object","additionalProperties":false,"required":["adapter","repository","path","anchor","source_url"],"properties":{"adapter":{"type":"string","minLength":1},"repository":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"anchor":{"$ref":"#/$defs/nullableString"},"source_url":{"$ref":"#/$defs/nullableString"}}},
    "block":{"type":"object","additionalProperties":false,"required":["id","kind","title","text","order","locator","parent_id","concepts","learning_objectives","metadata","hash"],"properties":{"id":{"type":"string","minLength":1},"kind":{"enum":["course","activity","section","exercise","assessment"]},"title":{"type":"string"},"text":{"type":"string"},"order":{"type":"integer","minimum":0},"locator":{"$ref":"#/$defs/locator"},"parent_id":{"$ref":"#/$defs/nullableString"},"concepts":{"type":"array","items":{"type":"string"},"uniqueItems":true},"learning_objectives":{"type":"array","items":{"type":"string"},"uniqueItems":true},"metadata":{"type":"object"},"hash":{"$ref":"#/$defs/hash"}}},
    "release":{"type":"object","additionalProperties":false,"required":["id","course_key","language","version","title","blocks","source","content_license","canonical_course_id","metadata","hash"],"properties":{"id":{"type":"string","minLength":1},"course_key":{"type":"string","minLength":1},"language":{"type":"string","minLength":2},"version":{"type":"string","minLength":1},"title":{"type":"string"},"blocks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/block"}},"source":{"$ref":"#/$defs/locator"},"content_license":{"$ref":"#/$defs/nullableString"},"canonical_course_id":{"$ref":"#/$defs/nullableString"},"metadata":{"type":"object"},"hash":{"$ref":"#/$defs/hash"}}},
    "evidenceRef":{"type":"object","additionalProperties":false,"required":["course_release_id","block_id","block_hash","excerpt"],"properties":{"course_release_id":{"type":"string","minLength":1},"block_id":{"type":"string","minLength":1},"block_hash":{"$ref":"#/$defs/hash"},"excerpt":{"$ref":"#/$defs/nullableString"}}},
    "modelRun":{"type":"object","additionalProperties":false,"required":["provider","model","prompt_version","configuration","input_hash","output_hash","latency_ms","cost"],"properties":{"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"prompt_version":{"type":"string","minLength":1},"configuration":{"type":"object"},"input_hash":{"type":"string","minLength":1},"output_hash":{"type":"string","minLength":1},"latency_ms":{"type":["integer","null"],"minimum":0},"cost":{"type":["number","null"],"minimum":0}}},
    "finding":{"type":"object","additionalProperties":false,"required":["id","finding_type","title","explanation","severity","confidence","evidence","affected_languages","suggested_action","status","model_run","metadata"],"properties":{"id":{"type":"string","minLength":1},"finding_type":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"explanation":{"type":"string","minLength":1},"severity":{"enum":["info","low","medium","high","critical"]},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidenceRef"}},"affected_languages":{"type":"array","items":{"type":"string"},"uniqueItems":true},"suggested_action":{"$ref":"#/$defs/nullableString"},"status":{"enum":["proposed","confirmed","rejected","resolved","intentional_localization","partially_correct","cannot_determine"]},"model_run":{"oneOf":[{"$ref":"#/$defs/modelRun"},{"type":"null"}]},"metadata":{"type":"object"}}},
    "review":{"type":"object","additionalProperties":false,"required":["finding_id","decision","reviewer","rationale","created_at","evidence_quality","severity_assessment","usefulness","actionability","seconds_spent","review_round"],"properties":{"finding_id":{"type":"string","minLength":1},"decision":{"enum":["proposed","confirmed","rejected","resolved","intentional_localization","partially_correct","cannot_determine"]},"reviewer":{"type":"string","minLength":1},"rationale":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"evidence_quality":{"type":["string","null"]},"severity_assessment":{"type":["string","null"]},"usefulness":{"type":["integer","null"],"minimum":1,"maximum":5},"actionability":{"type":["string","null"]},"seconds_spent":{"type":["integer","null"],"minimum":0},"review_round":{"type":["string","null"]}}}
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://eii.edu.eu/schemas/safety-case-2.0.json","title":"EII Tutor Safety Case","type":"object","additionalProperties":false,
  "required":["id","schema_version","created_at","course_id","course_hash","dataset_version","prompt_version","evaluator_id","evaluator_version","evaluator_ruleset_hash","cases","gates","gate_results","release_decision","known_limitations","manifest_digest","human_evaluations","signature"],
  "properties":{"id":{"$ref":"#/$defs/hash"},"schema_version":{"const":"2.0"},"created_at":{"type":"string","format":"date-time"},"course_id":{"type":"string","minLength":1},"course_hash":{"$ref":"#/$defs/hash"},"dataset_version":{"type":"string","minLength":1},"prompt_version":{"type":"string","minLength":1},"evaluator_id":{"type":"string","minLength":1},"evaluator_version":{"type":"string","minLength":1},"evaluator_ruleset_hash":{"$ref":"#/$defs/hash"},"cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/case"}},"gates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gate"}},"gate_results":{"type":"object","minProperties":1,"additionalProperties":{"type":"boolean"}},"release_decision":{"enum":["configured_gates_passed","configured_gates_failed"]},"known_limitations":{"type":"array","items":{"type":"string"}},"manifest_digest":{"$ref":"#/$defs/hash"},"human_evaluations":{"type":"array","items":{"$ref":"#/$defs/human"}},"signature":{"type":["string","null"],"minLength":1}},
  "$defs":{
    "hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "fixture":{"type":"object","additionalProperties":false,"required":["id","claim","question","language","activity_id","properties"],"properties":{"id":{"type":"string","minLength":1},"claim":{"type":"string","minLength":1},"question":{"type":"string","minLength":1},"language":{"type":"string","minLength":2},"activity_id":{"type":["string","null"]},"properties":{"type":"object"}}},
    "modelRun":{"type":"object","additionalProperties":false,"required":["provider","model","prompt_version","configuration","input_hash","output_hash","latency_ms","cost"],"properties":{"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"prompt_version":{"type":"string","minLength":1},"configuration":{"type":"object"},"input_hash":{"type":"string","minLength":1},"output_hash":{"type":"string","minLength":1},"latency_ms":{"type":["integer","null"],"minimum":0},"cost":{"type":["number","null"],"minimum":0}}},
    "retrieved":{"type":"object","additionalProperties":false,"required":["block_id","block_hash","text","score"],"properties":{"block_id":{"type":"string","minLength":1},"block_hash":{"$ref":"#/$defs/hash"},"text":{"type":"string"},"score":{"type":["number","null"]}}},
    "response":{"type":"object","additionalProperties":false,"required":["answer","citations","retrieved","model_run"],"properties":{"answer":{"type":"string"},"citations":{"type":"array","items":{"type":"string"},"uniqueItems":true},"retrieved":{"type":"array","items":{"$ref":"#/$defs/retrieved"}},"model_run":{"$ref":"#/$defs/modelRun"}}},
    "evaluation":{"type":"object","additionalProperties":false,"required":["evaluator","passed","explanation","evidence"],"properties":{"evaluator":{"type":"string","minLength":1},"passed":{"type":"boolean"},"explanation":{"type":"string","minLength":1},"evidence":{"type":"object"}}},
    "case":{"type":"object","additionalProperties":false,"required":["fixture","response","evaluations","passed"],"properties":{"fixture":{"$ref":"#/$defs/fixture"},"response":{"$ref":"#/$defs/response"},"evaluations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evaluation"}},"passed":{"type":"boolean"}}},
    "gate":{"type":"object","additionalProperties":false,"required":["claim","required_pass_rate","minimum_cases"],"properties":{"claim":{"type":"string","minLength":1},"required_pass_rate":{"type":"number","minimum":0,"maximum":1},"minimum_cases":{"type":"integer","minimum":1}}},
    "human":{"type":"object","additionalProperties":false,"required":["fixture_id","reviewer","approved","rationale","created_at"],"properties":{"fixture_id":{"type":"string","minLength":1},"reviewer":{"type":"string","minLength":1},"approved":{"type":"boolean"},"rationale":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"}}}
  }
}
